# Desenvolvimento local: corresponde ao docker-compose.yml.
# Use outras credenciais e URL no ambiente hospedado.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omni_db
SPRING_DATASOURCE_USERNAME=omni_user
SPRING_DATASOURCE_PASSWORD=omni_password

# Segurança: JWT_SECRET obrigatório; gere com: openssl rand -hex 32
# Nunca reutilize chaves de desenvolvimento em produção.
JWT_SECRET=
JWT_REFRESH_EXPIRATION=604800000
MASTER_JWT_SECRET=
MASTER_PASSWORD=
MASTER_EMAIL=

# CORS
ALLOWED_ORIGINS=
